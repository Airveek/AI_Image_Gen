NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAILS=
NEXT_PUBLIC_SITE_URL=https://airveek.com
# Optional HTML-meta verification tokens (DNS verification is preferred).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_APP_URL=https://airveek.com

# SEO measurement and automation (server-only unless prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-2FZ4GPQLP0
GA4_PROPERTY_ID=
GA4_MEASUREMENT_PROTOCOL_SECRET=
GOOGLE_SEO_SERVICE_ACCOUNT_JSON_BASE64=
# Evidence recording must name the exact image provider/model; leave blank
# rather than inventing metadata when running outside a configured provider.
AIRVEEK_GENERATION_PROVIDER=
AIRVEEK_GENERATION_MODEL=
GSC_SITE_URL=sc-domain:airveek.com
GCP_PROJECT_ID=
# Search Console imports use the Search Analytics API; keep GSC data in BigQuery
# separately if you enable Google's optional bulk export (not read by this app).
# GA4 export dataset, e.g. project-id.analytics_123456789 (optional; when blank,
# the worker probes the standard analytics_<property-id> dataset automatically)
GA4_BIGQUERY_DATASET=
BING_WEBMASTER_API_KEY=
BING_SITE_URL=https://airveek.com
# Bing's JSON/HTTP (REST) page-reporting method. The legacy SOAP/POX surface
# retires 2026-08-31; IndexNow remains independent of reporting.
BING_WEBMASTER_STATS_ENDPOINT=https://ssl.bing.com/webmaster/api.svc/json/GetPageStats
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
SEO_ATTRIBUTION_SIGNING_SECRET=
SEO_ALERT_WEBHOOK_URL=
# Optional signed handoff endpoint for the long-running content-production
# agent. It receives briefs and calls /api/seo/agent/callback with a draft;
# dispatch never publishes or changes indexability.
SEO_CONTENT_AGENT_WEBHOOK_URL=
SEO_CONTENT_AGENT_SIGNING_SECRET=
# Set true when the owner-operated Mac/Codex bridge is the execution worker.
# This keeps hosted Inngest from competing for the same queue.
SEO_CONTENT_AGENT_LOCAL_ONLY=false
SEO_CONTENT_AGENT_BATCH_SIZE=5
# Number of ready briefs the five-minute assignment loop can route per tick.
SEO_CONTENT_ASSIGNMENT_BATCH_SIZE=25
SEO_GSC_INSPECTION_DAILY_BUDGET=20
SEO_AUTOMATION_ENABLED=false
# Reader-first mode keeps rights/evidence optional while retaining technical,
# intent, content-quality, rendering, link, metadata, schema, and CTA gates.
SEO_EVIDENCE_GATES_ENABLED=false
# When true, a completed worker draft that passes all deterministic checks is
# recorded as editorial-approved automatically. It is still published only by
# the normal 50-page wave, render, and sitemap gates.
SEO_INSTANT_AGENT_APPROVAL_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DAILY_GENERATION_LIMIT=5

# Apindex store connector (server-only)
APINDEX_STORE_API_URL=https://your-apindex-domain.example
APINDEX_STORE_API_TOKEN=replace-with-the-same-long-random-token-used-in-Apindex
APINDEX_STORE_MEDIA_HOSTS=cdn.example.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_COMMERCIAL_PLAN_ID=
WHOP_PREMIUM_PLAN_ID=
WHOP_WEBHOOK_SECRET=
# Set true only when all Whop values belong to Whop Sandbox.
WHOP_SANDBOX=false
